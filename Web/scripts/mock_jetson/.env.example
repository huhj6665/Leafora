MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tld
MQTT_QOS=1

MOCK_START_LAT=39.12295
MOCK_START_LON=117.12270
MOCK_END_LAT=39.12402
MOCK_END_LON=117.12425
MOCK_SPEED_MPS=1.2
MOCK_SAMPLE_INTERVAL=0.5
MOCK_ROUTE_CURVE_M=12.0
MOCK_RANDOM_SEED=20260924

MOCK_DISEASE_RATE=0.82
MOCK_DISEASE_CLUSTER_COUNT=2
MOCK_DISEASE_SIGMA_M=22.0

TLD_API_BASE_URL=http://127.0.0.1:8000/api
# 设备 HTTP 凭据原文；服务端仅保存 bcrypt 摘要
MOCK_DEVICE_SECRET=
MOCK_DISEASE_IMAGES_DIR=
MOCK_NORMAL_IMAGES_DIR=
MOCK_IMAGE_EVERY=5
MOCK_UPLOAD_RETRIES=3
MOCK_UPLOAD_RETRY_INTERVAL=1.0
