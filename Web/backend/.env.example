# ============================================================
# TLD Intelligent Inspection Platform - 环境变量模板
# 复制本文件为 .env 并按实际环境填写，.env 不应提交到版本库。
# ============================================================

# ---- 应用基础配置 ----
APP_NAME=TLD Intelligent Inspection Platform
# development / production / test
APP_ENV=development
DEBUG=false
API_PREFIX=/api

# ---- PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tld_db
DB_USER=tld_backend
DB_PASSWORD=

# ---- JWT ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- 密码加密 ----
BCRYPT_ROUNDS=12

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 阿里云号码认证服务（短信认证）----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
# 模板参数（JSON 字符串），"##code##" 占位符让阿里云动态生成并核验验证码
ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##"}
# 验证码长度 / 有效期（秒），默认 6 位纯数字、5 分钟
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_VALID_TIME=300
# 短信供应商：mock / aliyun（留空则按是否配置 AccessKey 自动选择）
SMS_PROVIDER=mock

# ---- 短信发送限流 ----
RATE_LIMIT_ENABLED=true

# ---- 163 SMTP 邮件发送（邮箱绑定 / 密码找回）----
# 说明：SMTP_PASSWORD 是 163 邮箱的「客户端授权码」，不是网页登录密码。
#       在网易邮箱「设置 → POP3/SMTP/IMAP → 开启 SMTP 服务」中获取授权码。
# 以下三项需由你填写真实值；.env.example 只保留占位符，不写真实授权码。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TLD智能巡检平台
SMTP_TIMEOUT=15

# ---- 邮箱验证码 ----
# 验证码位数 / 有效期（秒）/ 单个凭据最大失败尝试次数
EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_MAX_ATTEMPTS=5

# ---- 开发文档开关（生产环境建议 false）----
ENABLE_DOCS=true

# ---- MQTT Broker ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# 统一 Topic 前缀：{prefix}/device/{device_id}/data
MQTT_TOPIC_PREFIX=tld

# ---- 图片存储（本地文件系统根目录）----
# 相对路径基于 backend 运行目录；生产可配置绝对路径或后续迁移对象存储
IMAGE_STORAGE_ROOT=storage
IMAGE_MAX_SIZE_MB=10
# 设备 HTTP 上传图片时，若巡检记录尚未入库（图片先到），有界等待该记录出现
IMAGE_PENDING_WAIT_SECONDS=5.0
IMAGE_PENDING_POLL_INTERVAL=0.5

# ---- 云端模型服务（RT-DETR-L）----
# 留空表示模型服务未部署，图片上传仍可用，推理任务置 model_unavailable
MODEL_SERVICE_URL=
MODEL_WEIGHT_PATH=
MODEL_DEVICE=cpu
MODEL_CONFIDENCE=0.5
MODEL_IMAGE_SIZE=800
MODEL_NAME=RT-DETR-L
MODEL_VERSION=v1.0

# ---- DeepSeek 辅助分析（可选；留空时使用本地规则化摘要）----
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20

# ---- 农业助手（均只在后端填写，留空会明确显示能力未配置）----
ASSISTANT_RUN_TIMEOUT_SECONDS=180
ASSISTANT_MODEL_TIMEOUT_SECONDS=60
ASSISTANT_MAX_ROUNDS=6
ASSISTANT_MAX_TOOL_CALLS=12
ASSISTANT_MAX_DAILY_RUNS=100
ASSISTANT_MAX_DAILY_TOKENS=500000
ASSISTANT_STORAGE_ROOT=storage/assistant
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# JWT优先；填写私钥路径时自动使用JWT。不要把私钥写进源码。
QWEATHER_KEY_ID=
QWEATHER_PROJECT_ID=
QWEATHER_PRIVATE_KEY_PATH=
TAVILY_API_KEY=

# ---- 高德地图（前端配置写入 frontend/.env，勿提交 Web 服务 Key）----

# ---- 开发工具开关（模拟设备 / 测试页面 / seed 脚本）----
ENABLE_DEV_TOOLS=true
DEV_SIM_DEVICE_ID=TLD_JETSON_001
DEV_SIM_DEVICE_NAME=TLD Simulator
