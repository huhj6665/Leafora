# 复制为 runtime/device.env，并执行 chmod 600 runtime/device.env。
DEVICE_ID=TLD_SIM_002
DEVICE_SECRET=

# Jetson 启动先经 CLI 确认电脑局域网地址；Tkinter 暂停。
# 不能使用 localhost、127.0.0.1，也不要把某次开发电脑 IP 固化到模板。
BACKEND_URL=
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

CAMERA_DEVICE=/dev/video0
GPS_UART_PATH=/dev/ttyACM0
GPS_BAUDRATE=38400
SAMPLE_INTERVAL_S=0.5
MIN_FREE_DISK_MB=512
PRINT_SAMPLE_JSON=true
ALLOW_LEGACY_CONTROL=false

# NTRIP 可选；未配置时使用普通 GPS。不要把真实凭据提交到源码。
NTRIP_ENABLED=false
NTRIP_SERVER=
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=
NTRIP_USERNAME=
NTRIP_PASSWORD=
