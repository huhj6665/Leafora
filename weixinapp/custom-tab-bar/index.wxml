<view class="tab-bar">
  <view class="tab-row">
    <button wx:for="{{list}}" wx:key="pagePath" class="tab-item {{selected === index ? 'is-selected' : ''}}" hover-class="tab-item-pressed" hover-stay-time="80" data-index="{{index}}" bindtap="switchTab" aria-role="tab" aria-label="{{item.text}}" aria-selected="{{selected === index}}">
      <text class="tab-label">{{item.text}}</text>
      <view class="tab-indicator" wx:if="{{selected === index}}"></view>
    </button>
  </view>
</view>
