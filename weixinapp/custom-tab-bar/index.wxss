:host { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif; }
.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  box-sizing: border-box;
  padding: 10rpx 16rpx 8rpx;
  padding-bottom: calc(8rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #DFE7DF;
  background: #FFFDF8;
  box-shadow: 0 -6rpx 24rpx rgba(23, 62, 50, .04);
}
.tab-row { display: flex; align-items: center; gap: 6rpx; }
.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 48px;
  height: 92rpx;
  margin: 0;
  padding: 0 4rpx;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  color: #64746B;
  line-height: 1;
}
.tab-item::after { border: 0; }
.tab-label { font-size: 32rpx; font-weight: 500; line-height: 44rpx; white-space: nowrap; }
.is-selected { background: #E8F2E9; color: #226B4B; }
.is-selected .tab-label { font-weight: 700; }
.tab-indicator { position: absolute; bottom: 8rpx; width: 28rpx; height: 4rpx; border-radius: 4rpx; background: #2F7D59; }
.tab-item-pressed { background: #EFF4ED; }
