.home{padding:46rpx 28rpx calc(36rpx + env(safe-area-inset-bottom))}.top{display:flex;align-items:flex-start;justify-content:space-between}.greeting,.date{display:block}.greeting{margin-top:8rpx;font-size:42rpx;font-weight:760;color:#173E32}.date{margin-top:8rpx;color:#859189;font-size:23rpx}.connection{display:flex;align-items:center;margin-top:8rpx;padding:10rpx 14rpx;border-radius:999rpx;background:#E7F2E9;color:#29694C;font-size:20rpx}.connection .dot{width:12rpx;height:12rpx;margin-right:8rpx;border-radius:50%;background:#3E9C64}.login-card{margin-top:36rpx;padding:34rpx;border-radius:28rpx;background:#FFFDF9;box-shadow:0 14rpx 36rpx rgba(38,73,54,.08)}.login-card>text{display:block;color:#68786E;line-height:1.7}.login-card button{margin-top:24rpx}.hero,.active-card{margin-top:34rpx;padding:36rpx;border-radius:30rpx;background:linear-gradient(145deg,#204F3D,#13372D);color:#fff;box-shadow:0 18rpx 44rpx rgba(28,76,53,.25)}.hero-kicker{color:#BAD3C2;font-size:19rpx;letter-spacing:3rpx}.hero-title{display:block;margin-top:14rpx;font-size:40rpx;font-weight:760}.hero-copy{display:block;margin-top:12rpx;color:rgba(255,255,255,.67);font-size:23rpx;line-height:1.55}.hero-action{display:flex;justify-content:space-between;margin-top:30rpx;padding-top:22rpx;border-top:1rpx solid rgba(255,255,255,.16);font-weight:650}.active-head{display:flex;justify-content:space-between;color:#C2D8C9;font-size:22rpx}.active-name{display:block;margin-top:20rpx;font-size:38rpx;font-weight:750}.active-meta{display:block;margin-top:8rpx;color:rgba(255,255,255,.68);font-size:22rpx}.bar{height:10rpx;margin-top:26rpx;border-radius:99rpx;background:rgba(255,255,255,.16)}.bar view{height:100%;border-radius:99rpx;background:#E8CA73}.overview{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:16rpx}.overview view{padding:22rpx 14rpx;border-radius:20rpx;background:#FFFDF9}.overview text{display:block}.overview .strong{color:#246647;font-size:32rpx;font-weight:700}.overview view>text:last-child{margin-top:5rpx;color:#849087;font-size:20rpx}.section-head{display:flex;justify-content:space-between;margin:34rpx 4rpx 16rpx}.section-head>text:first-child{font-size:30rpx;font-weight:700}.section-head>text:last-child{color:#A06A37;font-size:20rpx}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.quick-grid>view{padding:24rpx;border-radius:22rpx;background:#FFFDF9}.quick-grid .icon{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;margin-bottom:18rpx;border-radius:17rpx;background:#E6F1E8;color:#276D4D;font-size:30rpx}.quick-grid .strong,.quick-grid>view>text:last-child{display:block}.quick-grid .strong{font-size:27rpx;font-weight:700}.quick-grid>view>text:last-child{margin-top:6rpx;color:#8C9890;font-size:20rpx}.devices-link{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;padding:25rpx;border-radius:22rpx;background:#EDF2E9}.devices-link view text{display:block}.devices-link .strong{font-weight:700}.devices-link view text:last-child{margin-top:5rpx;color:#7E8B83;font-size:21rpx}.devices-link>text{font-size:38rpx;color:#4F7561}
