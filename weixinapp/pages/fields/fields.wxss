.head { display: flex; align-items: flex-end; justify-content: space-between; }.create { margin: 0; border-radius: 999rpx; background: #E5F1E8; color: #226B4B; }
.intro { display: block; margin: 12rpx 2rpx 28rpx; color: #7D8A82; font-size: 24rpx; }
.field-card { position: relative; overflow: hidden; height: 380rpx; margin-bottom: 24rpx; border-radius: 28rpx; background: #315B45; box-shadow: 0 16rpx 34rpx rgba(37,75,54,.16); }
.cover, .shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }.placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #C8D7CD; }.placeholder text:first-child { font-size: 36rpx; letter-spacing: 5rpx; }.placeholder text:last-child { margin-top: 8rpx; font-size: 22rpx; }
.shade { background: linear-gradient(180deg,rgba(9,32,22,.06),rgba(9,32,22,.82)); }.field-copy { position: absolute; left: 28rpx; right: 28rpx; bottom: 28rpx; }.badges { display: flex; gap: 10rpx; }.name { display: block; margin-top: 14rpx; color: #fff; font-size: 38rpx; font-weight: 750; }.meta { display: block; margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 22rpx; }
.risk { position: absolute; top: 22rpx; right: 22rpx; padding: 13rpx 16rpx; border-radius: 15rpx; background: rgba(255,253,249,.9); }.risk text { display:block; color:#7C8981;font-size:19rpx; }.risk .strong { margin-top:3rpx;color:#285D45;font-size:22rpx; }
