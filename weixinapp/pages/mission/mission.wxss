.steps{display:flex;align-items:flex-start;margin:34rpx 4rpx 18rpx}.step{display:flex;flex-direction:column;align-items:center;color:#9AA59E;font-size:20rpx}.step .step-number{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;margin-top:0;border-radius:50%;background:#E4E9E5}.step text{margin-top:7rpx}.step.on{color:#256B4C}.step.on .step-number{background:#2E7956;color:#fff}.line{flex:1;height:2rpx;margin:24rpx 9rpx 0;background:#D7DFD9}.choice{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;padding:24rpx;border:2rpx solid transparent;border-radius:22rpx;background:#FFFDF9}.choice.selected{border-color:#3A8461;background:#EFF7F0}.choice.disabled{opacity:.58}.choice-title,.choice-sub,.reason{display:block}.choice-title{font-size:30rpx;font-weight:700}.choice-sub{margin-top:7rpx;color:#7E8B83;font-size:22rpx}.reason{margin-top:8rpx;color:#A7603D;font-size:21rpx}.radio{display:inline-flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin-left:10rpx;border:2rpx solid #B7C7BD;border-radius:50%;color:#2F7D59}.checks{padding:10rpx 28rpx}.check{display:flex;align-items:center;padding:19rpx 0;border-bottom:1rpx solid #E8ECE8}.check-icon{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin-right:18rpx;border-radius:50%;background:#E6F2E9;color:#26704D}.check-icon.bad{background:#FFF0ED;color:#B84C44}.check text{display:block}.check text:last-child{margin-top:4rpx;color:#8A978F;font-size:21rpx}.rtk,.notice{margin-top:18rpx;padding:20rpx;border-radius:16rpx;background:#FFF4DD;color:#805F28;font-size:22rpx;line-height:1.6}.summary>view{padding:18rpx 0;border-bottom:1rpx solid #ECEFEB}.summary text{display:block;color:#8B978F;font-size:22rpx}.summary .strong{margin-top:6rpx;color:#244B3D;font-weight:700}.summary input{height:70rpx;margin-top:7rpx}.footer{display:flex;gap:16rpx;margin-top:30rpx}.footer button{flex:1}
