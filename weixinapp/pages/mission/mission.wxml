<view class="page tab-page">
  <text class="eyebrow">INSPECTION</text><text class="page-title">开始一次巡检</text>
  <view class="steps"><view class="step {{step>=1?'on':''}}"><text class="step-number">1</text><text>烟田</text></view><view class="line"></view><view class="step {{step>=2?'on':''}}"><text class="step-number">2</text><text>设备</text></view><view class="line"></view><view class="step {{step>=3?'on':''}}"><text class="step-number">3</text><text>检查</text></view><view class="line"></view><view class="step {{step>=4?'on':''}}"><text class="step-number">4</text><text>确认</text></view></view>
  <view class="error-box" wx:if="{{errorMsg}}">{{errorMsg}}</view><view class="skeleton" wx:if="{{loading}}"></view>

  <block wx:if="{{!loading && step===1}}"><view class="section-title">选择 READY 烟田</view><view class="choice {{selectedField.field_id===item.field_id?'selected':''}} {{!item.ready?'disabled':''}}" wx:for="{{fields}}" wx:key="field_id" data-index="{{index}}" bindtap="selectField"><view><text class="choice-title">{{item.display_name}}</text><text class="choice-sub">{{item.calibration_label}}</text></view><view><text class="pill simulated" wx:if="{{item.is_simulated}}">演示</text><text class="radio">{{selectedField.field_id===item.field_id?'✓':''}}</text></view></view><view class="empty" wx:if="{{fields.length===0}}">没有可用烟田，请确认云端已导入 A-01。</view></block>
  <block wx:if="{{step===2}}"><view class="section-title">选择已绑定设备</view><view class="choice {{selectedDevice.device_id===item.device_id?'selected':''}} {{!item.selectable?'disabled':''}}" wx:for="{{devices}}" wx:key="device_id" data-index="{{index}}" bindtap="selectDevice"><view><text class="choice-title">{{item.display_name}}</text><text class="choice-sub">{{item.device_id}} · {{item.status_label}}</text><text class="reason" wx:if="{{!item.selectable}}">{{item.unavailable_reason}}</text></view><view><text class="pill simulated" wx:if="{{item.is_simulated}}">虚拟设备</text><text class="radio">{{selectedDevice.device_id===item.device_id?'✓':''}}</text></view></view><view class="empty" wx:if="{{devices.length===0}}">暂无设备，请先扫码绑定。</view><button class="secondary-btn" wx:if="{{devices.length===0}}" bindtap="openDevices">前往绑定设备</button></block>
  <block wx:if="{{step===3 && preflight}}"><view class="section-title">启动前检查</view><view class="card checks"><view class="check" wx:for="{{preflight.checks}}" wx:key="key"><text class="check-icon {{item.ok?'ok':'bad'}}">{{item.ok?'✓':'!'}}</text><view><text>{{item.label}}</text><text>{{item.value}}</text></view></view><view class="rtk">精度提示：{{preflight.rtk_hint}}</view></view></block>
  <block wx:if="{{step===4}}"><view class="section-title">确认任务</view><view class="card summary"><view><text>烟田</text><text class="strong">{{selectedField.display_name}}</text></view><view><text>设备</text><text class="strong">{{selectedDevice.display_name}}</text></view><view><text>任务名称</text><input value="{{name}}" placeholder="可选，例如 上午巡检" bindinput="onName"/></view></view><view class="notice">这是云端业务级采集任务，不会直接控制无人机电机、姿态或航线。提交后需等待设备返回 ACCEPTED，才算真正开始。</view></block>
  <view class="footer" wx:if="{{!loading}}"><button class="secondary-btn" wx:if="{{step>1}}" bindtap="previous">上一步</button><button class="primary-btn" wx:if="{{step<4}}" bindtap="next">继续</button><button class="primary-btn" wx:else loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交开始请求</button></view>
</view>
