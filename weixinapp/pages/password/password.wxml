<view class="page">
  <view class="card">
    <view class="title">设置手机号登录密码</view>
    <view class="desc">必须再次验证当前账号绑定的手机号。设置成功后旧会话会失效，需要使用新密码重新登录。</view>
    <view class="field"><text>手机号</text><input type="number" maxlength="11" placeholder="当前账号绑定手机号" value="{{phone}}" bindinput="onPhone" /></view>
    <view class="field"><text>验证码</text><input type="number" maxlength="6" placeholder="6 位短信验证码" value="{{code}}" bindinput="onCode" /><button size="mini" disabled="{{sending || countdown > 0}}" bindtap="sendCode">{{countdown ? countdown + 's' : '获取验证码'}}</button></view>
    <view class="field"><text>新密码</text><input password placeholder="至少 6 位，包含字母和数字" value="{{password}}" bindinput="onPassword" /></view>
    <view class="field"><text>确认密码</text><input password placeholder="再次输入" value="{{confirmPassword}}" bindinput="onConfirm" /></view>
    <button class="primary-btn submit" disabled="{{loading}}" loading="{{loading}}" bindtap="submit">验证并设置密码</button>
    <view class="success" wx:if="{{message}}">{{message}}</view>
    <view class="error-box" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </view>
</view>
