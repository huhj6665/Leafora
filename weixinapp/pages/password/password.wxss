.title { font-size: 36rpx; font-weight: 700; }
.desc { color: #64748b; line-height: 1.6; margin: 14rpx 0 30rpx; }
.field { display: flex; align-items: center; min-height: 94rpx; border-bottom: 2rpx solid #e2e8f0; gap: 14rpx; }
.field > text { width: 150rpx; flex-shrink: 0; }
.field input { flex: 1; min-width: 0; }
.field button { margin: 0; flex-shrink: 0; color: #2563eb; background: #eff6ff; font-size: 23rpx; }
.submit { margin-top: 40rpx; }
.success { margin-top: 22rpx; color: #047857; }
