.hero{padding:34rpx;border-radius:30rpx;background:linear-gradient(145deg,#173E32,#286C4E);color:#fff;box-shadow:0 18rpx 42rpx rgba(28,80,56,.24)}.hero .eyebrow{color:#BBD5C4}.title{display:block;margin-top:12rpx;font-size:42rpx;font-weight:760}.subtitle{display:block;margin-top:8rpx;color:rgba(255,255,255,.68);font-size:23rpx}.progress{overflow:hidden;height:12rpx;margin-top:30rpx;border-radius:99rpx;background:rgba(255,255,255,.18)}.progress view{height:100%;border-radius:99rpx;background:#EACB75;transition:width .35s}.hero-meta{display:flex;justify-content:space-between;margin-top:10rpx;font-size:22rpx}.timeline{display:flex;justify-content:space-between;margin:28rpx 0}.node{display:flex;flex:1;flex-direction:column;align-items:center;color:#98A39C;font-size:19rpx}.node .node-dot{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;margin-bottom:7rpx;border-radius:50%;background:#DFE5E0}.node.done .node-dot,.node.active .node-dot{background:#2F7D59;color:#fff}.map-card{position:relative;overflow:hidden;height:410rpx;border-radius:26rpx;background:#DFE8DE}.map-card image,.map-empty{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%}.map-empty{display:flex;align-items:center;justify-content:center;color:#819087}.grid-cell{position:absolute;opacity:.5}.track-point{position:absolute;width:8rpx;height:8rpx;margin:-4rpx;border-radius:50%;background:#fff;box-shadow:0 0 0 4rpx #277653}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin:20rpx 0}.metrics view{padding:20rpx;border-radius:18rpx;background:#FFFDF9}.metrics text{display:block;color:#8A978F;font-size:20rpx}.metrics .strong{margin-top:7rpx;color:#244B3D;font-size:24rpx;font-weight:700}.offline{margin:18rpx 0;padding:20rpx;border-radius:16rpx;background:#FFF3DA;color:#805F28;font-size:23rpx;line-height:1.6}
.terminal-error{margin:18rpx 0;padding:20rpx;border-radius:16rpx;background:#FFF0ED;color:#A33F38;font-size:23rpx;line-height:1.6}
