<view class="page"><view class="error-box" wx:if="{{errorMsg}}">{{errorMsg}}</view><view class="skeleton" wx:if="{{!mission}}"></view><block wx:if="{{mission}}">
  <view class="hero status-{{mission.status}}"><text class="eyebrow">{{mission.accepted?'DEVICE ACKNOWLEDGED':'WAITING FOR ACK'}}</text><text class="title">{{mission.status_label}}</text><text class="subtitle">{{mission.field_name || mission.field_id}} · {{mission.device_name || mission.device_id}}</text><view class="progress"><view style="width:{{mission.progress_percent}}%"></view></view><view class="hero-meta"><text>{{mission.progress_known ? mission.progress_percent+'%' : '进度未报告'}}</text><text>{{freshness.label}}{{freshness.ageSeconds===null?'':' · '+freshness.ageSeconds+'s'}}</text></view></view>
  <view class="timeline"><view class="node done"><text class="node-dot">✓</text><text>请求已提交</text></view><view class="node {{mission.accepted?'done':'active'}}"><text class="node-dot">{{mission.accepted?'✓':'·'}}</text><text>设备确认</text></view><view class="node {{mission.status==='RUNNING'||mission.status==='RUNNING_OFFLINE'||mission.status==='ENDING'||mission.status==='SYNCING'||mission.status==='COMPLETED'?'done':''}}"><text class="node-dot">·</text><text>运行</text></view><view class="node {{mission.status==='SYNCING'||mission.status==='COMPLETED'?'done':''}}"><text class="node-dot">·</text><text>同步</text></view><view class="node {{mission.status==='COMPLETED'?'done':''}}"><text class="node-dot">·</text><text>完成</text></view></view>
  <view class="map-card"><image wx:if="{{live.background_url}}" src="{{live.background_url}}" mode="aspectFill"/><view wx:else class="map-empty">等待烟田底图与轨迹</view><view class="grid-cell" wx:for="{{live.risk_grid}}" wx:key="index" style="left:{{item.x_pct}}%;top:{{item.y_pct}}%;width:{{item.width_pct}}%;height:{{item.height_pct}}%;background:{{item.risk_color}}" data-index="{{index}}" bindtap="showGrid"></view><view class="track-point" wx:for="{{live.track}}" wx:key="index" style="left:{{item.x_pct}}%;top:{{item.y_pct}}%"></view></view>
  <view class="offline">{{mission.source_label}} · {{mission.calibration_hint}}</view>
  <view class="metrics"><view><text>GPS / RTK</text><text class="strong">{{live.location.fix_text || '暂无有效数据'}} / {{live.location.rtk_text || '未报告'}}</text></view><view><text>高度(m) / 速度(m/s)</text><text class="strong">{{live.location.altitude_text || '暂无有效数据'}} / {{live.location.speed_text || '暂无有效数据'}}</text></view><view><text>温度(℃) / 湿度(%)</text><text class="strong">{{live.environment.temperature_text || '暂无有效数据'}} / {{live.environment.humidity_text || '暂无有效数据'}}</text></view><view><text>CO₂ / 光照</text><text class="strong">{{live.environment.co2_text || '暂无有效数据'}} / {{live.environment.light_text || '暂无有效数据'}}</text></view><view><text>识别数量</text><text class="strong">{{live.detection.count_text || '暂无有效数据'}}</text></view><view><text>待同步</text><text class="strong">{{mission.pending_sync == null ? '未报告' : mission.pending_sync}}</text></view></view>
  <view class="offline" wx:if="{{live.sample_hints}}">{{live.sample_hints}}</view>
  <view class="offline" wx:if="{{live.module_hint}}">{{live.module_hint}}</view>
  <view class="offline" wx:if="{{mission.status==='RUNNING_OFFLINE'}}">设备正在离线运行，任务不会被误判失败；恢复网络后将继续补传。</view>
  <view class="terminal-error" wx:if="{{mission.status==='FAILED'||mission.status==='REJECTED'||mission.status==='EXPIRED'||mission.status==='CANCELLED'}}">{{mission.failure_reason || mission.reason || '任务未能继续，请检查设备状态后重新发起。'}}</view>
  <button class="danger-btn" wx:if="{{mission.status==='RUNNING'||mission.status==='RUNNING_OFFLINE'}}" loading="{{ending}}" disabled="{{ending}}" bindtap="requestEnd">结束巡检</button><button class="primary-btn" wx:if="{{mission.status==='COMPLETED'}}" bindtap="openRecord">查看完整记录</button>
</block></view>
