.map-card { position:relative;overflow:hidden;height:500rpx;border-radius:30rpx;background:#DDE7DE;box-shadow:0 16rpx 36rpx rgba(37,73,53,.15); }.map-card image,.map-empty,.map-tint{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;}.map-empty{display:flex;align-items:center;justify-content:center;color:#728279}.map-tint{background:linear-gradient(180deg,transparent 52%,rgba(12,41,27,.8));}.map-caption{position:absolute;left:28rpx;bottom:26rpx;color:#fff}.map-caption text{display:block}.map-caption text:first-child{font-size:38rpx;font-weight:750}.map-caption text:last-child{margin-top:6rpx;opacity:.7;font-size:22rpx}.grid-cell{position:absolute;opacity:.48;border:1rpx solid rgba(255,255,255,.8)}.track-point{position:absolute;width:8rpx;height:8rpx;margin:-4rpx;border-radius:50%;background:#fff;box-shadow:0 0 0 4rpx rgba(37,112,77,.65)}
.badges{display:flex;gap:12rpx;margin:20rpx 2rpx}.info{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}.info text{display:block;color:#8A978F;font-size:22rpx}.info .strong{margin-top:6rpx;color:#244B3D}.event text{display:block}.event text:last-child{margin-top:7rpx;color:#829087;font-size:23rpx}
