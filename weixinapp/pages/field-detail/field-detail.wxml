<view class="page">
  <view class="error-box" wx:if="{{errorMsg}}">{{errorMsg}}</view><view class="skeleton" wx:if="{{loading}}"></view>
  <block wx:if="{{field}}">
    <view class="map-card"><image wx:if="{{field.display_image}}" src="{{field.display_image}}" mode="aspectFill" /><view wx:else class="map-empty">底图待云端提供</view><view class="map-tint"></view><view class="grid-cell" wx:for="{{field.risk_grid}}" wx:key="index" style="left:{{item.x_pct}}%;top:{{item.y_pct}}%;width:{{item.width_pct}}%;height:{{item.height_pct}}%;background:{{item.risk_color}}" data-index="{{index}}" bindtap="showGrid"></view><view class="track-point" wx:for="{{field.track}}" wx:key="index" style="left:{{item.x_pct}}%;top:{{item.y_pct}}%"></view><view class="map-caption"><text>{{field.display_name}}</text><text>{{field.field_id}}</text></view></view>
    <view class="badges"><text class="pill">{{field.status_label}}</text><text class="pill simulated" wx:if="{{field.is_simulated}}">模拟校准 · 演示数据</text></view>
    <view class="card info"><view><text>数据来源</text><text class="strong">{{field.data_source || '--'}}</text></view><view><text>坐标系</text><text class="strong">{{field.coordinate_system || 'WGS84'}}</text></view><view><text>版本</text><text class="strong">v{{field.version || '--'}}</text></view><view><text>最近风险</text><text class="strong">{{field.risk_summary || '暂无'}}</text></view></view>
    <button class="primary-btn" disabled="{{!field.ready}}" bindtap="start">选择此烟田开始巡检</button>
    <view class="section-title">最近巡检</view><view class="card event" wx:for="{{recent}}" wx:key="inspection_id" data-id="{{item.inspection_id}}" bindtap="openInspection"><text>{{item.name || '巡检任务'}}</text><text>{{item.status_label}} · {{item.display_time}}</text></view><view class="empty" wx:if="{{recent.length===0}}">该烟田暂无巡检记录</view>
  </block>
</view>
