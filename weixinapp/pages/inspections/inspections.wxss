.tabs { display: flex; background: #fffdf9; border-radius: 18rpx; padding: 8rpx; margin-bottom: 18rpx; }
.tab { flex: 1; text-align: center; padding: 18rpx; color: #64748b; border-radius: 10rpx; }
.active { background: #e7f2e9; color: #256b4c; font-weight: 600; }
.filters { display: flex; overflow-x: auto; align-items: center; gap: 12rpx; margin-bottom: 20rpx; white-space: nowrap; }
.filters picker view { padding: 12rpx 18rpx; border-radius: 999rpx; background: #fffdf9; color: #52685c; font-size: 21rpx; }
.filters > text { color: #a45a4c; font-size: 21rpx; }
.filter { color: #64748b; font-size: 24rpx; margin: 16rpx 4rpx; }
.item, .meta { display: flex; flex-direction: column; }
.head { display: flex; justify-content: space-between; gap: 20rpx; }
.name { font-size: 31rpx; font-weight: 650; }
.status { color: #68766d; font-size: 23rpx; }.status.current { color: #27704f; }
.meta { color: #94a3b8; font-size: 23rpx; margin-top: 10rpx; }
.counts { display: flex; gap: 28rpx; color: #64748b; font-size: 24rpx; margin-top: 22rpx; }
.loading { text-align: center; color: #94a3b8; padding: 30rpx; }
