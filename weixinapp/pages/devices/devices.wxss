.head{display:flex;align-items:flex-end;justify-content:space-between}.bind{margin:0;border-radius:999rpx;background:#E3F0E6;color:#246A4A}.intro{display:block;margin:12rpx 2rpx 28rpx;color:#7C8981;font-size:23rpx;line-height:1.6}.device-card{margin-bottom:18rpx;padding:26rpx;border-radius:24rpx;background:#FFFDF9;box-shadow:0 10rpx 30rpx rgba(38,72,54,.07)}.device-top{display:flex;align-items:center}.device-icon{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;margin-right:17rpx;border-radius:22rpx 22rpx 22rpx 7rpx;background:#DDEDE1;color:#246A4A;font-size:32rpx;font-weight:800}.name,.id{display:block}.name{font-size:30rpx;font-weight:700}.id{margin-top:5rpx;color:#8A978F;font-size:21rpx}.state{margin-left:auto;padding:7rpx 13rpx;border-radius:999rpx;background:#EEF1EE;color:#68766D;font-size:20rpx}.state-READY{background:#E1F2E5;color:#24704C}.state-BUSY,.state-SYNCING{background:#FFF1D5;color:#8A6223}.state-ERROR{background:#FFE9E5;color:#A94139}.reason{display:block;margin-top:18rpx;padding:13rpx 16rpx;border-radius:12rpx;background:#F7F2E7;color:#87662E;font-size:21rpx}.meta{display:flex;justify-content:space-between;margin-top:18rpx;color:#8A978F;font-size:20rpx}
