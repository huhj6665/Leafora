.form{margin-top:32rpx}.form>text{display:block;color:#607269;font-size:23rpx}.form input{height:90rpx;margin:10rpx 0 26rpx;padding:0 22rpx;border:2rpx solid #D4DED7;border-radius:16rpx;background:#F8FAF6}.step{display:flex;align-items:center;padding:20rpx 0;border-top:1rpx solid #E9EDE9}.step .step-number{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;margin-right:18rpx;border-radius:50%;background:#E6F1E8;color:#2A704F}.step text{display:block}.step view text:last-child{margin-top:5rpx;color:#89958E;font-size:22rpx}.form button{margin-top:24rpx}.notice{padding:22rpx;color:#876324;background:#FFF4DD;border-radius:18rpx;font-size:23rpx;line-height:1.7}
