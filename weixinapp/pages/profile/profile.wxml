<view class="page tab-page"><text class="eyebrow">ACCOUNT</text><text class="page-title">我的 Leafora</text><view class="profile-card"><view class="avatar">{{avatarText}}</view><view><text class="name">{{user ? (user.nickname || '已登录用户') : '尚未登录'}}</text><text class="phone">{{user ? (user.phone_masked || user.phone || '手机号账号') : '登录后管理设备与巡检'}}</text></view><button wx:if="{{!user}}" size="mini" bindtap="login">登录</button></view><view class="stats" wx:if="{{user}}"><view><text class="strong">{{deviceCount}}</text><text>已绑定设备</text></view><view><text class="strong">JWT</text><text>云端身份</text></view></view><view class="menu"><view bindtap="devices"><text>我的设备</text><text>绑定、状态与解绑 ›</text></view><view bindtap="password"><text>登录密码</text><text>短信验证后设置 ›</text></view><view bindtap="network"><text>局域网连接</text><text>{{server}} ›</text></view></view><button class="danger-btn" wx:if="{{user}}" bindtap="logout">退出登录</button><view class="footnote">小程序仅向云端提交业务级任务请求，不连接 MQTT，也不直接控制无人机。</view></view>
