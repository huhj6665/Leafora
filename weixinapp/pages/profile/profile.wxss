.profile-card{display:flex;align-items:center;margin-top:30rpx;padding:30rpx;border-radius:26rpx;background:linear-gradient(145deg,#214F3E,#17382E);color:#fff}.avatar{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin-right:20rpx;border-radius:30rpx 30rpx 30rpx 10rpx;background:#EAD69A;color:#22503E;font-size:42rpx;font-weight:800}.name,.phone{display:block}.name{font-size:32rpx;font-weight:700}.phone{margin-top:7rpx;color:rgba(255,255,255,.65);font-size:22rpx}.profile-card button{margin-left:auto;color:#245D45;background:#F1E7C8}.stats{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:18rpx 0}.stats view{padding:22rpx;border-radius:20rpx;background:#FFFDF9}.stats text{display:block;margin-top:4rpx;color:#8B978F;font-size:21rpx}.stats .strong{margin-top:0;font-size:32rpx;color:#27694D;font-weight:700}.menu{overflow:hidden;margin:22rpx 0;border-radius:24rpx;background:#FFFDF9}.menu view{display:flex;align-items:center;justify-content:space-between;padding:27rpx;border-bottom:1rpx solid #EAEDE9}.menu view text:last-child{max-width:58%;overflow:hidden;color:#87938C;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.footnote{margin-top:25rpx;color:#849089;font-size:22rpx;line-height:1.65;text-align:center}
