page {
  background: #F4F6F1;
  color: #17342B;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}
button::after { border: 0; }
button { font-size: 28rpx; }
.page { padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom)); }
.page.tab-page, .home.tab-page { padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); }
.card { margin-bottom: 22rpx; padding: 28rpx; border: 1rpx solid rgba(31,74,57,.07); border-radius: 24rpx; background: #FFFDF9; box-shadow: 0 10rpx 34rpx rgba(39,73,54,.07); }
.eyebrow { display: block; color: #6A8A79; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; text-transform: uppercase; }
.page-title { display: block; margin-top: 8rpx; color: #163C30; font-size: 44rpx; font-weight: 750; line-height: 1.22; }
.section-title { margin: 34rpx 4rpx 18rpx; color: #244B3D; font-size: 31rpx; font-weight: 700; }
.primary-btn { border-radius: 999rpx; background: linear-gradient(135deg, #2F7D59, #1F6347); color: #fff; font-weight: 650; box-shadow: 0 10rpx 24rpx rgba(34,107,75,.18); }
.primary-btn[disabled] { background: #B9C6BE; color: #EEF2EF; box-shadow: none; }
.secondary-btn { border: 2rpx solid #C9D9D0; border-radius: 999rpx; background: #FFFDF9; color: #27694D; }
.danger-btn { border: 2rpx solid #E7C8C3; border-radius: 999rpx; background: #FFF9F7; color: #B5463F; }
.muted { color: #839189; }
.error-box { margin: 20rpx 0; padding: 20rpx 22rpx; border-radius: 16rpx; background: #FFF0ED; color: #A93D37; font-size: 24rpx; line-height: 1.55; }
.empty { padding: 70rpx 28rpx; color: #8B978F; text-align: center; line-height: 1.7; }
.pill { display: inline-flex; align-items: center; padding: 7rpx 15rpx; border-radius: 999rpx; background: #EAF4ED; color: #28704F; font-size: 21rpx; }
.simulated { background: #FFF2D8; color: #8A6223; }
.skeleton { overflow: hidden; min-height: 120rpx; border-radius: 20rpx; background: linear-gradient(90deg,#E8ECE8 25%,#F5F7F4 37%,#E8ECE8 63%); background-size: 400% 100%; animation: shimmer 1.3s infinite; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
